generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  puzzles       Puzzle[]
  progresses    Progress[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Puzzle {
  id         String     @id @default(cuid())
  title      String?
  // 81文字。'0' は空マス
  givens     String
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  progresses Progress[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([createdAt])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  puzzleId  String
  // 81文字。'0' は未回答
  values    String
  // 81要素。候補1..9をbit0..8で表すビットマスク
  memos     Int[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, puzzleId])
}
